# =============================================================================
# razorbills-whatsapp environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development:  cp .env.example .env
#
# NEVER commit a real `.env`. In production every secret below is injected by
# your secret manager (AWS Secrets Manager, GCP Secret Manager, Vault, Docker
# secrets, Kubernetes Secrets, ...), not by a file in the image.
#
# This service is single-owner and stores everything on the local filesystem.
# There is no database and no Redis: DATA_DIR is the only stateful dependency.
#
# Startup FAILS when the process runs with NODE_ENV=production and a required
# secret is missing or insecurely configured (see src/config/env.js).
# =============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=razorbills-whatsapp
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Persistent storage (the ONLY stateful dependency)
# ----------------------------------------------------------------------------
# Everything lives here: API key digests, instances, connection state, session
# archives, deliveries, audit events. Point this at a private, persistent,
# access-restricted volume mounted into the container. Never commit it.
# Production refuses to start on a non-existent/unwritable directory; using the
# default "./data" in production emits a warning.
DATA_DIR=./data
# Single-owner tenant id. Do not change after instances exist.
DEFAULT_TENANT_ID=default

# ----------------------------------------------------------------------------
# API keys
# ----------------------------------------------------------------------------
# Server-side pepper mixed into the HMAC used to store API keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum length is 32 characters. Rotating the pepper invalidates all keys.
API_KEY_PEPPER=
# Optional default lifetime for newly created keys, in days. 0 = no expiry.
API_KEY_DEFAULT_TTL_DAYS=0

# ----------------------------------------------------------------------------
# Encryption at rest (AES-256-GCM)
# ----------------------------------------------------------------------------
# ENCRYPTION_KEY_PROVIDER: "env" (development / simple) or "file" (production,
# keyring file mounted from a secret store). Keys are base64-encoded 32 bytes.
ENCRYPTION_KEY_PROVIDER=env
# Active key id. Old keys stay in the ring so old ciphertext can still decrypt.
ENCRYPTION_KEY_ID=k1
# Inline keyring, ONLY for development. Format: {"k1":"<base64 32 bytes>"}
ENCRYPTION_KEYS=
# Production: JSON file containing {"k1":"<base64 32 bytes>", ...}
ENCRYPTION_KEYS_FILE=

# ----------------------------------------------------------------------------
# Connectors
# ----------------------------------------------------------------------------
# Default connector for newly created instances: cloud_api | web
DEFAULT_CONNECTOR=cloud_api

# --- Official WhatsApp Business Platform (Cloud API) — DEFAULT, production ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# --- Authorized WhatsApp Web connector — DISABLED BY DEFAULT ---------------
# Only enable when you hold the required written authorization for the exact
# intended use of the WhatsApp Web connector. Enabling this flag without
# WHATSAPP_WEB_AUTHORIZATION_REFERENCE makes startup fail on purpose.
#
# This connector is NOT an official WhatsApp API. Its browser profile lives under
# DATA_DIR/instances/<id>/session and is NOT encrypted by this service (the
# "remote_encrypted" strategy encrypts the session archive instead).
ENABLE_WHATSAPP_WEB_CONNECTOR=false
# Reference to the authorization/permission record (contract, ticket, DPA id).
# It is recorded in the audit log; never put a secret here.
WHATSAPP_WEB_AUTHORIZATION_REFERENCE=
# "local"            -> whatsapp-web.js LocalAuth (disk profile, NOT encrypted at rest)
# "remote_encrypted" -> RemoteAuth backed by this service's AES-256-GCM store
WHATSAPP_WEB_AUTH_STRATEGY=local
WHATSAPP_WEB_HEADLESS=true
# Leave false: Chromium's sandbox is part of the isolation. Set true only when
# the host blocks unprivileged user namespaces and the SUID sandbox is unusable.
WHATSAPP_WEB_NO_SANDBOX=false
# How often WhatsApp itself re-issues a pairing code (WhatsApp default 180000).
WHATSAPP_WEB_PAIRING_INTERVAL_MS=180000
# Optional per-instance browser launch timeout (ms).
WHATSAPP_WEB_LAUNCH_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# Connection recovery
# ----------------------------------------------------------------------------
# Recover previously-live instances after a restart. Cloud API instances are
# reconnected automatically; the Web connector always requires the owner so a
# restart never generates an unsolicited QR code.
AUTO_RECONNECT_ON_STARTUP=true
RECONNECT_ENABLED=true
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=300000
RECONNECT_MAX_ATTEMPTS=10
RECONNECT_MAX_DURATION_MS=900000
# Random jitter factor applied to each backoff delay (0 = no jitter).
RECONNECT_JITTER=0.2
# How long a connection must stay healthy before the retry counter resets.
RECONNECT_STABLE_RESET_MS=60000

# ----------------------------------------------------------------------------
# Outbound messaging (used by the RazorBills backend)
# ----------------------------------------------------------------------------
OUTBOUND_MESSAGING_ENABLED=true
# How long a stored idempotency key suppresses a duplicate send.
IDEMPOTENCY_TTL_MS=86400000
# Retention for outbound delivery metadata, in days (0 = do not retain).
DELIVERY_METADATA_RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# HTTP security
# ----------------------------------------------------------------------------
# Comma-separated allowlist. Empty allows only requests without an Origin
# header (server-to-server). "*" is rejected in production.
CORS_ORIGINS=
TRUST_PROXY=false
BODY_LIMIT=100kb
# Optional source-IP allowlist (exact IPv4/IPv6 addresses or IPv4 CIDR ranges).
# Empty disables the check. Use it to restrict the API to the backend's egress.
IP_ALLOWLIST=

# ----------------------------------------------------------------------------
# Owner dashboard sessions (ww2web — see docs/admin-dashboard.md)
# ----------------------------------------------------------------------------
# Sessions are in-memory only: nothing is written to DATA_DIR.
OWNER_SESSION_TTL_MS=43200000
OWNER_SESSION_IDLE_MS=3600000
OWNER_SESSION_MAX=20
# Defaults to true in production. Only set false when testing the dashboard
# over plain HTTP on a trusted host.
# OWNER_SESSION_COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Rate limiting (in-memory; per API key and per IP — counters reset on restart)
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CONNECT_WINDOW_MS=60000
RATE_LIMIT_CONNECT_MAX_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
# Outbound sends per key/IP, and per recipient.
RATE_LIMIT_SEND_WINDOW_MS=60000
RATE_LIMIT_SEND_MAX_REQUESTS=120
RATE_LIMIT_RECIPIENT_WINDOW_MS=60000
RATE_LIMIT_RECIPIENT_MAX_REQUESTS=20

# ----------------------------------------------------------------------------
# Browser / instance limits
# ----------------------------------------------------------------------------
MAX_BROWSER_INSTANCES=3
QR_TTL_MS=45000

# ----------------------------------------------------------------------------
# Real-time event streams
# ----------------------------------------------------------------------------
STREAM_TOKEN_TTL_MS=60000
SSE_HEARTBEAT_MS=15000
SSE_MAX_STREAM_MS=1800000

# ----------------------------------------------------------------------------
# Pagination, retention and audit
# ----------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
# Message content is NOT persisted unless this is true (explicit opt-in).
RETAIN_MESSAGE_CONTENT=false
DEFAULT_RETENTION_DAYS=7
MAX_RETENTION_DAYS=365
AUDIT_EVENTS_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# Shutdown
# ----------------------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=15000
