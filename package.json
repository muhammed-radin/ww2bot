{
  "name": "razorbills-whatsapp",
  "version": "1.0.0",
  "private": true,
  "description": "Private, single-owner WhatsApp service for the RazorBills backend: an official Cloud API connector by default, an opt-in authorization-gated WhatsApp Web connector, and file-based persistence only.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "key:create": "node scripts/create-api-key.js",
    "key:revoke": "node scripts/revoke-api-key.js",
    "key:rotate": "node scripts/rotate-api-key.js",
    "session:purge": "node scripts/purge-retained-data.js",
    "setup:web-connector": "npm install --include=optional whatsapp-web.js puppeteer",
    "sync:docs": "node scripts/sync-docs.js",
    "build:frontend": "node scripts/build-frontend.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/security/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:security": "node --test \"tests/security/**/*.test.js\"",
    "test:integration:live": "WA_GATEWAY_LIVE_TESTS=1 node --test \"tests/live/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "puppeteer": "^25.14.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
